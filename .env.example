# OpenRouter-compatible configuration. Replace the model if needed for your account.
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0

# Optional: store demo CSV files outside the repository.
# BANKING_DATA_DIR=/path/to/private/demo-data